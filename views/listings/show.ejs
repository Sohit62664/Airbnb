<% layout("/layouts/boilerplate")%>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        #map {
            height: 400px;
            width: 100%;
        }

        #map img {
            max-width: none !important;
        }
    </style>
    <div class="container mt-5">

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">


            <!-- Heading -->
            <h2 class="card-title text-center text-primary fw-bold mb-4">
                <%= listing.title %>
            </h2>


            <!-- Listing Image -->
            <img src="<%= listing.image %>" class="card-img-top listing-img" alt="listing_image"
                style="max-height: 500px; width: 100%; object-fit: contain;">

            <div class="card-body">



                <!-- Details -->
                <ul class="list-group list-group-flush fs-5">



                    <li class="list-group-item py-3">
                        <strong>Description :</strong>
                        <%= listing.description %>
                    </li>

                    <li class="list-group-item py-3">
                        <strong>Price :</strong>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    </li>

                    <li class="list-group-item py-3">
                        <strong>Location :</strong>
                        <%= listing.location %>
                    </li>

                    <li class="list-group-item py-3">
                        <strong>Country :</strong>
                        <%= listing.country %>
                    </li>

                    <% if (listing.owner) { %>
                        <li class="list-group-item py-3"> <strong>Listed by:</strong>
                            <%= listing.owner.username %>
                        </li>
                        <li class="list-group-item py-3"> <strong>Contact:</strong>
                            <%= listing.owner.email %>
                        </li>
                        <% } %>

                </ul>

                <!-- Buttons -->
                <% if (currUser && listing.owner && listing.owner.equals(currUser._id)) { %>

                    <div class="d-flex gap-3 mt-4">

                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                            <button class="btn btn-danger px-4">
                                Delete
                            </button>
                        </form>

                        <a href="/listings/<%= listing._id %>/edit">
                            <button class="btn btn-warning px-4">
                                Edit
                            </button>
                        </a>

                    </div>

                    <% } %>



                        <% if (currUser) { %>

                            <% const isFavorite=currUser.favorites.some( fav=> fav.toString() === listing._id.toString()
                                ); %>

                                <% if (isFavorite) { %>

                                    <form method="POST" action="/listings/<%= listing._id %>/favorite?_method=DELETE">

                                        <button class="btn btn-danger d-flex gap-3 mt-4">
                                            ♥ Remove from Favorites
                                        </button>

                                    </form>

                                    <% } else { %>

                                        <form method="POST" action="/listings/<%= listing._id %>/favorite">

                                            <button class="btn btn-outline-danger mt-4">
                                                ♡ Add to Favorites
                                            </button>

                                        </form>

                                        <% } %>

                                            <% } %>


            </div>

        </div>
        <% if (listing.locationCoordinates && listing.locationCoordinates.lat && listing.locationCoordinates.lng) { %>

            <hr class="my-5">

            <h3 class="mb-3">Location</h3>

            <div id="map" class="rounded-3 shadow-sm" style="height: 400px; width: 100%;">
            </div>

            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

            <script>
                const lat = <%= listing.locationCoordinates.lat %>;
                const lng = <%= listing.locationCoordinates.lng %>;

                const map = L.map("map").setView([lat, lng], 13);

                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                L.marker([lat, lng])
                    .addTo(map)
                    .bindPopup("<%= listing.title %>")
                    .openPopup();
            </script>

            <% } else { %>

                <hr class="my-5">

                <h3 class="mb-3">Location</h3>

                <div class="alert alert-warning">
                    Location map is not available for this listing.
                </div>

                <% } %>
                    <div class="coll-8 offset-3">
                        <h4>Leave a Review</h4>

                        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate
                            class="needs-validation">
                            <div class="mmb-3 mt-8">
                                <label for="rating">Ratings</label>
                                <input type="range" min="1" max="5" id="rating" name="review[rating]">

                                <label for="comment" class="form-control">Comment</label>
                                <textarea name="review[comment]" id="comment" rows="4" cols="50" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">Please add some comment to sumbmit Review</div>
                                <button class="d-flex gap-3 mt-4">Submit</button>
                            </div>
                        </form>
                    </div>

                    <hr>






                    <!-- <h4>All Reviews</h4> -->

                    <h4 class="mb-3">All Reviews</h4>

                    <% let count=1; %>

                        <div class="row">
                            <% for(let rev of listing.reviews){ %>

                                <div class="col-md-6 mb-3">
                                    <div class="card shadow-sm">
                                        <div class="card-body" style="margin-left: 1%;">

                                            <h5 class="card-title">
                                                Review <%= count %>
                                            </h5>

                                            <!-- Review Author -->
                                            <% if (rev.author) { %>
                                                <p class="card-text">
                                                    <strong>Reviewed by:</strong>
                                                    <%= rev.author.username %>
                                                </p>
                                                <% } %>

                                                    <p class="card-text">
                                                        <strong>Rating:</strong>
                                                        <span class="badge bg-success">
                                                            <%= rev.rating %> ★
                                                        </span>
                                                    </p>

                                                    <p class="card-text">
                                                        <strong>Comment:</strong>
                                                        <%= rev.comment %>
                                                    </p>

                                                    <!-- Delete only for review author -->
                                                    <% if (currUser && rev.author &&
                                                        rev.author._id.equals(currUser._id)) { %>

                                                        <div class="d-flex justify-content-end me-3">
                                                            <form method="POST"
                                                                action="/listings/<%= listing._id %>/reviews/<%= rev._id %>?_method=DELETE">

                                                                <button class="btn btn-danger btn-sm">
                                                                    Delete
                                                                </button>

                                                            </form>
                                                        </div>

                                                        <% } %>

                                        </div>
                                    </div>
                                </div>

                                <% count++; %>

                                    <% } %>
                        </div>

    </div>