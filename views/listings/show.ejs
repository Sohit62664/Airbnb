<% layout("/layouts/boilerplate") %>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />


    <div class="show-page">

        <!-- =========================
         LISTING
    ========================== -->

        <div class="show-listing">

            <!-- Listing Image -->

            <img src="<%= listing.image %>" class="show-image" alt="<%= listing.title %>">


            <!-- Listing Content -->

            <div class="show-content">

                <!-- Title -->

                <h1 class="show-title">
                    <%= listing.title %>
                </h1>


                <!-- Location -->

                <p class="show-location">
                    <i class="fa-solid fa-location-dot"></i>

                    <%= listing.location %>, <%= listing.country %>
                </p>


                <!-- Price -->

                <p class="show-price">
                    ₹ <%= listing.price.toLocaleString("en-IN") %>

                        <span>/ night</span>
                </p>


                <!-- Description -->

                <h3 class="show-section-title">
                    About this place
                </h3>

                <p class="show-description">
                    <%= listing.description %>
                </p>


                <!-- Host -->

                <% if (listing.owner) { %>

                    <div class="host-box">

                        <div class="host-label">
                            Listed by
                        </div>

                        <div class="host-name">
                            <%= listing.owner.username %>
                        </div>

                        <div class="host-email">
                            <%= listing.owner.email %>
                        </div>

                    </div>

                    <% } %>


                        <!-- Owner Actions -->

                        <% if ( currUser && listing.owner && listing.owner.equals(currUser._id) ) { %>

                            <div class="show-actions">

                                <!-- Edit -->

                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">

                                    <i class="fa-solid fa-pen"></i>

                                    Edit

                                </a>


                                <!-- Delete -->

                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">

                                    <button class="btn btn-danger">

                                        <i class="fa-solid fa-trash"></i>

                                        Delete

                                    </button>

                                </form>

                            </div>

                            <% } %>


                                <!-- =========================
                 FAVORITE
            ========================== -->

                                <% if (currUser) { %>

                                    <% const isFavorite=currUser.favorites.some( fav=> fav.toString() ===
                                        listing._id.toString()
                                        ); %>


                                        <% if (isFavorite) { %>

                                            <form method="POST"
                                                action="/listings/<%= listing._id %>/favorite?_method=DELETE">

                                                <button class="btn btn-danger favorite-btn">

                                                    <i class="fa-solid fa-heart"></i>

                                                    Remove from Favorites

                                                </button>

                                            </form>


                                            <% } else { %>

                                                <form method="POST" action="/listings/<%= listing._id %>/favorite">

                                                    <button class="btn btn-outline-danger favorite-btn">

                                                        <i class="fa-regular fa-heart"></i>

                                                        Add to Favorites

                                                    </button>

                                                </form>

                                                <% } %>

                                                    <% } %>

            </div>

        </div>


        <!-- =========================
         LOCATION
    ========================== -->

        <div class="location-section">

            <h2 class="location-title">
                Location
            </h2>


            <% if ( listing.locationCoordinates && listing.locationCoordinates.lat && listing.locationCoordinates.lng )
                { %>

                <div id="map" class="map-container"></div>

                <% } else { %>

                    <div class="alert alert-warning">

                        Location map is not available for this listing.

                    </div>

                    <% } %>

        </div>


        <!-- =========================
         REVIEW FORM
    ========================== -->

        <% if (currUser) { %>

            <div class="review-section">

                <h2 class="reviews-title">
                    Leave a Review
                </h2>


                <div class="review-box">

                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate
                        class="needs-validation">

                        <!-- =========================
                         STAR RATING
                    ========================== -->

                        <div class="mb-3">

                            <label class="review-label">
                                Rating
                            </label>


                            <div class="star-rating">

                                <!-- 5 -->

                                <input type="radio" id="star5" name="review[rating]" value="5">

                                <label for="star5">
                                    ★
                                </label>


                                <!-- 4 -->

                                <input type="radio" id="star4" name="review[rating]" value="4">

                                <label for="star4">
                                    ★
                                </label>


                                <!-- 3 -->

                                <input type="radio" id="star3" name="review[rating]" value="3">

                                <label for="star3">
                                    ★
                                </label>


                                <!-- 2 -->

                                <input type="radio" id="star2" name="review[rating]" value="2">

                                <label for="star2">
                                    ★
                                </label>


                                <!-- 1 -->

                                <input type="radio" id="star1" name="review[rating]" value="1">

                                <label for="star1">
                                    ★
                                </label>

                            </div>

                        </div>


                        <!-- =========================
                         COMMENT
                    ========================== -->

                        <div class="mb-3">

                            <label for="comment" class="review-label">
                                Comment
                            </label>


                            <textarea name="review[comment]" id="comment" class="form-control review-comment"
                                placeholder="Share your experience..." required></textarea>


                            <div class="invalid-feedback">

                                Please add some comment to submit a review.

                            </div>

                        </div>


                        <!-- Submit -->

                        <button class="btn btn-dark px-4">

                            Submit Review

                        </button>

                    </form>

                </div>

            </div>

            <% } %>


                <!-- =========================
         ALL REVIEWS
    ========================== -->

                <div class="reviews-section">

                    <h2 class="reviews-title">
                        Guest Reviews
                    </h2>


                    <% if (listing.reviews.length===0) { %>

                        <div class="no-reviews">

                            No reviews yet.
                            Be the first to review this listing.

                        </div>


                        <% } else { %>


                            <div class="row g-4">

                                <% let count=1; %>


                                    <% for(let rev of listing.reviews){ %>

                                        <div class="col-md-6">

                                            <div class="review-card">

                                                <!-- Review number -->

                                                <div class="review-number">

                                                    Review <%= count %>

                                                </div>


                                                <!-- Author -->

                                                <% if (rev.author) { %>

                                                    <p class="review-author">

                                                        <strong>
                                                            Reviewed by:
                                                        </strong>

                                                        <%= rev.author.username %>

                                                    </p>

                                                    <% } %>


                                                        <!-- =========================
                                 STAR DISPLAY
                            ========================== -->

                                                        <div class="review-stars">

                                                            <% for(let i=1; i <=5; i++) { %>

                                                                <% if (i <=rev.rating) { %>

                                                                    <span class="star-filled">
                                                                        ★
                                                                    </span>

                                                                    <% } else { %>

                                                                        <span class="star-empty">
                                                                            ☆
                                                                        </span>

                                                                        <% } %>

                                                                            <% } %>

                                                                                <span class="rating-number">
                                                                                    <%= rev.rating %>/5
                                                                                </span>

                                                        </div>


                                                        <!-- Comment -->

                                                        <p class="review-comment-text">

                                                            <strong>
                                                                Comment:
                                                            </strong>

                                                            <%= rev.comment %>

                                                        </p>


                                                        <!-- Delete review -->

                                                        <% if ( currUser && rev.author &&
                                                            rev.author._id.equals(currUser._id) ) { %>

                                                            <div class="text-end">

                                                                <form method="POST"
                                                                    action="/listings/<%= listing._id %>/reviews/<%= rev._id %>?_method=DELETE">

                                                                    <button class="btn btn-outline-danger btn-sm">

                                                                        Delete

                                                                    </button>

                                                                </form>

                                                            </div>

                                                            <% } %>

                                            </div>

                                        </div>


                                        <% count++; %>

                                            <% } %>

                            </div>

                            <% } %>

                </div>

    </div>


    <!-- =========================
     LEAFLET MAP
========================== -->

    <% if ( listing.locationCoordinates && listing.locationCoordinates.lat && listing.locationCoordinates.lng ) { %>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


        <script>

            const lat = <%= listing.locationCoordinates.lat %>;

            const lng = <%= listing.locationCoordinates.lng %>;


            const map = L.map("map").setView(
                [lat, lng],
                13
            );


            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    attribution:
                        "&copy; OpenStreetMap contributors"
                }
            ).addTo(map);


            L.marker([lat, lng])
                .addTo(map)
                .bindPopup(
                    "<%= listing.title %>"
                )
                .openPopup();

        </script>

        <% } %>