<% layout("layouts/boilerplate") %>
    <%= success %>
        <div class="container mt-5">
            <div class="container mt-4">

                <form action="/listings" method="GET" class="mb-4">

                    <div class="row g-2">

                        <!-- Search -->
                        <div class="col-md-5">
                            <input type="text" name="search" class="form-control"
                                placeholder="Search by title, location or country..." value="<%= search || '' %>">
                        </div>

                        <!-- Minimum Price -->
                        <div class="col-md-2">
                            <input type="number" name="minPrice" class="form-control" placeholder="Min price"
                                value="<%= minPrice || '' %>" min="0">
                        </div>

                        <!-- Maximum Price -->
                        <div class="col-md-2">
                            <input type="number" name="maxPrice" class="form-control" placeholder="Max price"
                                value="<%= maxPrice || '' %>" min="0">
                        </div>

                        <!-- Search Button -->
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-dark w-100">
                                Search
                            </button>
                        </div>

                        <!-- Clear -->
                        <div class="col-md-1">
                            <a href="/listings" class="btn btn-outline-secondary w-100">
                                Clear
                            </a>
                        </div>

                    </div>

                </form>
                <!-- Your existing listings grid -->

            </div>


            <div class="row">


                <% for(let listing of allListings){ %>

                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4">

                        <div class="card listing-card shadow border-0 rounded-4 overflow-hidden h-100">

                            <!-- Image -->
                            <img src="<%= listing.image %>" alt="listing_image" class="card-img-top"
                                style="height: 250px; object-fit: cover;">

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title fw-bold">
                                    <%= listing.title %>
                                </h5>

                                <p class="card-text text-success fs-5 fw-semibold">
                                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                                </p>

                                <div class="mt-auto">

                                    <a href="/listings/<%= listing._id %>" class="btn btn-dark w-100 rounded-pill">
                                        Show Details
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                    <% } %>

            </div>

        </div>