<% layout("/layouts/boilerplate") %>

    <div class="listing-form-page">

        <div class="listing-form-card">

            <!-- Header -->

            <div class="listing-form-header">

                <div class="listing-form-icon">
                    <i class="fa-solid fa-pen"></i>
                </div>

                <h1 class="listing-form-title">
                    Edit Listing
                </h1>

                <p class="listing-form-subtitle">
                    Update the details of your listing.
                </p>

            </div>


            <!-- Form -->

            <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

                <div class="row">


                    <!-- Title -->

                    <div class="col-md-6 mb-3">

                        <label for="title" class="listing-form-label">
                            Title
                        </label>

                        <input type="text" name="listing[title]" id="title" value="<%= listing.title %>"
                            class="listing-form-input" required>

                    </div>


                    <!-- Price -->

                    <div class="col-md-6 mb-3">

                        <label for="price" class="listing-form-label">
                            Price per night
                        </label>

                        <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" min="0"
                            class="listing-form-input" required>

                    </div>


                    <!-- Description -->

                    <div class="col-12 mb-3">

                        <label for="description" class="listing-form-label">
                            Description
                        </label>

                        <textarea name="listing[description]" id="description" class="listing-form-input"
                            required><%= listing.description %></textarea>

                    </div>


                    <!-- Image -->

                    <div class="col-12 mb-3">

                        <label for="image" class="listing-form-label">
                            Image URL
                        </label>

                        <input type="url" name="listing[image]" id="image" value="<%= listing.image %>"
                            class="listing-form-input">

                    </div>


                    <!-- Location -->

                    <div class="col-md-6 mb-3">

                        <label for="location" class="listing-form-label">
                            Location
                        </label>

                        <input type="text" name="listing[location]" id="location" value="<%= listing.location %>"
                            class="listing-form-input" required>

                    </div>


                    <!-- Country -->

                    <div class="col-md-6 mb-3">

                        <label for="country" class="listing-form-label">
                            Country
                        </label>

                        <input type="text" name="listing[country]" id="country" value="<%= listing.country %>"
                            class="listing-form-input" required>

                    </div>


                    <!-- Submit -->

                    <div class="col-12 mt-3">

                        <button type="submit" class="listing-submit-btn">
                            <i class="fa-solid fa-check"></i>
                            Save Changes
                        </button>

                    </div>

                </div>

            </form>


            <a href="/listings/<%= listing._id %>" class="listing-back-link">
                ← Back to listing
            </a>

        </div>

    </div>