<% layout("layouts/boilerplate") %>

    <div class="user-listings-page">

        <!-- Header -->

        <div class="user-listings-header">

            <div>

                <h1 class="user-listings-title">
                    <i class="fa-solid fa-heart favorite-heart"></i>
                    My Favorites
                </h1>

                <p class="user-listings-subtitle">
                    Your saved listings
                </p>

            </div>


            <span class="listings-count">
                <%= favorites.length %> Saved
            </span>

        </div>


        <!-- Empty -->

        <% if (favorites.length===0) { %>

            <div class="user-listings-empty">

                <div class="user-listings-empty-icon">
                    <i class="fa-regular fa-heart"></i>
                </div>

                <h3>
                    No favorites yet
                </h3>

                <p>
                    Start exploring listings and save the ones you love.
                </p>

                <a href="/listings" class="btn btn-dark rounded-pill px-4">
                    Explore Listings
                </a>

            </div>


            <% } else { %>


                <!-- Favorites Grid -->

                <div class="row g-4">

                    <% for (let listing of favorites) { %>

                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">

                            <div class="user-listing-card">

                                <!-- Image -->

                                <a href="/listings/<%= listing._id %>" class="user-listing-image-wrapper">

                                    <img src="<%= listing.image %>" class="user-listing-image"
                                        alt="<%= listing.title %>">

                                </a>


                                <!-- Content -->

                                <div class="user-listing-body">

                                    <h5 class="user-listing-title">
                                        <%= listing.title %>
                                    </h5>


                                    <p class="user-listing-location">

                                        <i class="fa-solid fa-location-dot"></i>

                                        <%= listing.location %>,
                                            <%= listing.country %>

                                    </p>


                                    <p class="user-listing-price">

                                        ₹<%= listing.price.toLocaleString("en-IN") %>

                                            <span>
                                                / night
                                            </span>

                                    </p>


                                    <div class="user-listing-actions">

                                        <a href="/listings/<%= listing._id %>" class="btn btn-dark">
                                            View Listing
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <% } %>

                </div>

                <% } %>

    </div>