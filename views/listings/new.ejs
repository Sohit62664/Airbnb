<% layout("/layouts/boilerplate")%>

    <body>

        <div class="container d-flex justify-content-center align-items-center min-vh-100">
            <div class="w-50">



                <h2 class="mb-4 text-center">
                    Create New Listing
                </h2>

                <form action="/listings" method="post" novalidate class="needs-validation row">

                    <div class="mb-3 col-md-6">
                        <label class="form-label">Title</label>
                        
                        <input type="text" name="listing[title]" placeholder="Enter The Title" required
                            class="form-control new-form">
                    </div>



                    <div class="mb-3 col-md-6 ">
                        <label class="form-label">Description</label>

                        <textarea name="listing[description]" placeholder="Enter The Description" rows="4" required
                            class="form-control"></textarea>

                        
                    </div>



                    <div class="mb-3 col-md-6">
                        <label class="form-label">Image URL</label>

                        <input type="text" class="form-control" name="listing[image]" class="form-control"
                            placeholder="Enter The Image URL">
                    </div>



                    <div class="mb-3 col-md-6">
                        <label class="form-label">Price</label>

                        <input type="number" class="form-control" name="listing[price]" placeholder="Enter The Price"
                            required>
                    </div>



                    <div class="mb-3 col-md-6">
                        <label class="form-label">Country</label>

                        <input type="text" class="form-control" name="listing[country]" placeholder="Enter Country Name"
                            required>
                    </div>



                    <div class="mb-3 col-md-6">
                        <label class="form-label">Location</label>

                        <input type="text" class="form-control" name="listing[location]"
                            placeholder="Enter The Location" required>
                    </div>


                    <div class="col-12">
                        <button class="btn btn-outline-primary">
                            Add Listing
                        </button>

                    </div>

                </form>

            </div>
        </div>    

    </body>