<% layout("/layouts/boilerplate") %>

    <div class="listing-form-page">

        <div class="listing-form-card">

            <!-- Header -->

            <div class="listing-form-header">

                <div class="listing-form-icon">
                    <i class="fa-solid fa-house"></i>
                </div>

                <h1 class="listing-form-title">
                    Create a New Listing
                </h1>

                <p class="listing-form-subtitle">
                    Share your place with the Wanderlust community.
                </p>

            </div>


            <!-- Form -->

            <form action="/listings" method="POST" novalidate class="needs-validation">

                <div class="row">


                    <!-- Title -->

                    <div class="col-md-6 mb-3">

                        <label for="title" class="listing-form-label">
                            Title
                        </label>

                        <input type="text" name="listing[title]" id="title" placeholder="e.g. Beautiful Villa in Goa"
                            class="listing-form-input" required>

                        <div class="invalid-feedback">
                            Please enter a title.
                        </div>

                    </div>


                    <!-- Price -->

                    <div class="col-md-6 mb-3">

                        <label for="price" class="listing-form-label">
                            Price per night
                        </label>

                        <input type="number" name="listing[price]" id="price" placeholder="e.g. 5000" min="0"
                            class="listing-form-input" required>

                        <div class="invalid-feedback">
                            Please enter a valid price.
                        </div>

                    </div>


                    <!-- Description -->

                    <div class="col-12 mb-3">

                        <label for="description" class="listing-form-label">
                            Description
                        </label>

                        <textarea name="listing[description]" id="description" placeholder="Describe your place..."
                            class="listing-form-input" required></textarea>

                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>

                    </div>


                    <!-- Image -->

                    <div class="col-12 mb-3">

                        <label for="image" class="listing-form-label">
                            Image URL
                        </label>

                        <input type="url" name="listing[image]" id="image" placeholder="https://example.com/image.jpg"
                            class="listing-form-input">

                    </div>


                    <!-- Location -->

                    <div class="col-md-6 mb-3">

                        <label for="location" class="listing-form-label">
                            Location
                        </label>

                        <input type="text" name="listing[location]" id="location" placeholder="e.g. Goa"
                            class="listing-form-input" required>

                        <div class="invalid-feedback">
                            Please enter a location.
                        </div>

                    </div>


                    <!-- Country -->

                    <div class="col-md-6 mb-3">

                        <label for="country" class="listing-form-label">
                            Country
                        </label>

                        <input type="text" name="listing[country]" id="country" placeholder="e.g. India"
                            class="listing-form-input" required>

                        <div class="invalid-feedback">
                            Please enter a country.
                        </div>

                    </div>


                    <!-- Submit -->

                    <div class="col-12 mt-3">

                        <button type="submit" class="listing-submit-btn">
                            <i class="fa-solid fa-plus"></i>
                            Create Listing
                        </button>

                    </div>

                </div>

            </form>


            <a href="/listings" class="listing-back-link">
                ← Back to listings
            </a>

        </div>

    </div>